# AWS (required — use @aws-sdk/client-bedrock-runtime ONLY, not @anthropic-ai/bedrock-sdk)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=           # optional if using instance role / AWS SSO
AWS_SECRET_ACCESS_KEY=       # optional if using instance role / AWS SSO
AWS_SESSION_TOKEN=           # optional if using instance role / AWS SSO

# Neo4j
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Datadog — service identity (required to filter your traces from other teams)
DD_SERVICE=ai-dungeon-master
DD_ENV=hackathon

# Datadog LLM Observability
DD_API_KEY=
DD_SITE=datadoghq.com
DD_LLMOBS_ENABLED=1
# Name you choose for this ML app. Keep it in env (not a code const) because
# dd-trace reads it at process startup via NODE_OPTIONS before app code runs.
DD_LLMOBS_ML_APP=ai-dm
DD_LLMOBS_AGENTLESS_ENABLED=1
DD_TRACE_AWS_SDK_BEDROCKRUNTIME_ENABLED=true
# Application Key (NOT API Key) — required for scripts/create-dashboard.ts. Create in Datadog Org Settings > Application Keys.
DD_APP_KEY=

# S3 Media Cache (TTS, music, and video caching across server restarts)
S3_MEDIA_CACHE_BUCKET=       # aws s3 mb s3://<name> --region us-east-1
S3_AUDIO_CACHE_BUCKET=       # deprecated — use S3_MEDIA_CACHE_BUCKET instead

# MiniMax TTS (opening monologue only)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=            # found in MiniMax platform dashboard
MINIMAX_MUSIC_API_KEY=

# Redis (conversation persistence, rate limiting, sessions)
REDIS_URL=redis://localhost:6379

# Auth (JWT)
JWT_SECRET=                  # generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=              # generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Server
PORT=3001
NODE_ENV=development
SKIP_NEO4J_CONNECTIVITY_CHECK=0
