{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--import dd-trace/initialize.mjs' tsx watch --env-file=../.env src/index.ts",
    "build": "tsc",
    "start": "NODE_OPTIONS='--import dd-trace/initialize.mjs' node --env-file=../.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bedrock": "tsx --env-file=../.env src/scripts/test-bedrock.ts"
  },
  "dependencies": {
    "@ai-dm/shared-types": "1.0.0",
    "@aws-sdk/client-bedrock-runtime": "^3.0.0",
    "@aws-sdk/client-s3": "^3.995.0",
    "@aws-sdk/s3-request-presigner": "^3.995.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dd-trace": "^5.86.0",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.2.6",
    "nanoid": "^5.1.6",
    "neo4j-driver": "^6.0.0",
    "p-queue": "^9.1.0",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@datadog/datadog-api-client": "^1.52.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "latest",
    "@vitest/coverage-v8": "^2.0.0",
    "tsx": "latest",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
